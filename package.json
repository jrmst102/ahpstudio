{
  "name": "ahpstudio",
  "version": "1.1.6",
  "description": "AHP Studio - Web-based Analytic Hierarchy Process decision support application",
  "author": "Dr. Jose Mendoza",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "cd server && npm install --production",
    "build:client": "npm install --prefix client && npm run build --prefix client",
    "start": "node server/src/app.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm start --prefix client",
    "test": "npm test --prefix server",
    "seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/s3-request-presigner": "^3.525.0",
    "mathjs": "^12.2.1",
    "uuid": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "ws": "^8.19.0"
  }
}
